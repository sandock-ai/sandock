{
  "name": "sandock-core",
  "description": "Shared sandbox open-core: provider-agnostic sandbox execution engine (docker/kubernetes/local providers, lock/ttl providers, pty session management). Consumed by apps/sandock-cloud (cloud) and apps/sandock (headless OpenAPI).",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandock-ai/sandock.git",
    "directory": "packages/sandock-core"
  },
  "bugs": "https://github.com/sandock-ai/sandock/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./sandbox": {
      "types": "./src/sandbox.ts",
      "default": "./src/sandbox.ts"
    },
    "./sandbox-provider/*": {
      "types": "./src/sandbox-provider/*",
      "default": "./src/sandbox-provider/*"
    },
    "./lock-provider": {
      "types": "./src/lock-provider/index.ts",
      "default": "./src/lock-provider/index.ts"
    },
    "./ttl-provider": {
      "types": "./src/ttl-provider/index.ts",
      "default": "./src/ttl-provider/index.ts"
    },
    "./pty-session-manager": {
      "types": "./src/pty-session-manager.ts",
      "default": "./src/pty-session-manager.ts"
    },
    "./cluster-config": {
      "types": "./src/cluster-config.ts",
      "default": "./src/cluster-config.ts"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "default": "./src/constants.ts"
    },
    "./utils/*": {
      "types": "./src/utils/*",
      "default": "./src/utils/*"
    },
    "./db": {
      "types": "./src/db/index.ts",
      "default": "./src/db/index.ts"
    },
    "./db/schema": {
      "types": "./src/db/schema.ts",
      "default": "./src/db/schema.ts"
    },
    "./sandbox-manager": {
      "types": "./src/sandbox-manager.ts",
      "default": "./src/sandbox-manager.ts"
    },
    "./sandbox-reconciler": {
      "types": "./src/sandbox-reconciler.ts",
      "default": "./src/sandbox-reconciler.ts"
    },
    "./scheduler": {
      "types": "./src/scheduler.ts",
      "default": "./src/scheduler.ts"
    },
    "./metrics": {
      "types": "./src/metrics.ts",
      "default": "./src/metrics.ts"
    },
    "./create-sandbox-logic": {
      "types": "./src/create-sandbox-logic.ts",
      "default": "./src/create-sandbox-logic.ts"
    },
    "./volume-provider": {
      "types": "./src/volume-provider.ts",
      "default": "./src/volume-provider.ts"
    },
    "./random-name": {
      "types": "./src/random-name.ts",
      "default": "./src/random-name.ts"
    },
    "./api/router": {
      "types": "./src/api/router.ts",
      "default": "./src/api/router.ts"
    },
    "./api/context": {
      "types": "./src/api/context.ts",
      "default": "./src/api/context.ts"
    },
    "./api/openapi": {
      "types": "./src/api/openapi.ts",
      "default": "./src/api/openapi.ts"
    },
    "./api/ops": {
      "types": "./src/api/ops.ts",
      "default": "./src/api/ops.ts"
    }
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@kubernetes/client-node": "1.3.0",
    "@orpc/contract": "^1.14.6",
    "@orpc/openapi": "^1.14.6",
    "@orpc/server": "^1.14.6",
    "@orpc/zod": "^1.14.6",
    "dockerode": "4.0.7",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "openlib": "workspace:*",
    "postgres": "^3.4.6",
    "sandock-contract": "workspace:*",
    "redis": "^5.8.2",
    "server-only": "^0.0.1",
    "tar-stream": "^3.1.7",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.43",
    "@types/node": "^24.13.2",
    "@types/tar-stream": "^3.1.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
