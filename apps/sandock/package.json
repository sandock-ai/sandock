{
  "name": "sandock-server",
  "description": "Headless, single-tenant sandbox execution service — OpenAPI only, no auth/UI. Consumes sandock-core.",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandock-ai/sandock.git",
    "directory": "apps/sandock"
  },
  "bugs": "https://github.com/sandock-ai/sandock/issues",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=react-server tsx watch src/server.ts",
    "start": "NODE_OPTIONS=--conditions=react-server tsx src/server.ts",
    "test": "NODE_OPTIONS=--conditions=react-server vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "verify:db": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-db.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@orpc/openapi": "^1.14.6",
    "@orpc/server": "^1.14.6",
    "drizzle-orm": "^0.45.1",
    "openlib": "workspace:*",
    "sandock-contract": "workspace:*",
    "sandock-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "drizzle-kit": "^0.31.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
